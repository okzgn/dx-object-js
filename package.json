{
  "name": "dx-object-js",
  "version": "5.0.0",
  "description": "A deeply observable Proxy with safe auto-vivification. Accessing missing paths returns 'Ghost' proxies that materialize upon assignment. Features comprehensive mutation, deletion, and undefined-access tracking via configurable callbacks (onMutation, onUndefined, onError).",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:types": "tsc -p test/tsconfig.json",
    "check:es6": "acorn --ecma2015 --module --silent index.js",
    "verify": "npm run check:es6 && npm test && npm run test:types"
  },
  "keywords": [
    "DX",
    "Developer",
    "Experience",
    "State",
    "State-management",
    "Data",
    "Data-management",
    "Reactive",
    "Reactive-state",
    "Proxy",
    "Observable",
    "Auto-vivification",
    "Lightweight",
    "Zero-dependency",
    "Dependency-free"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT",
  "author": "OKZGN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okzgn/dx-object-js.git"
  },
  "bugs": {
    "url": "https://github.com/okzgn/dx-object-js/issues"
  },
  "homepage": "https://github.com/okzgn/dx-object-js#readme",
  "devDependencies": {
    "acorn": "^8.19.0",
    "typescript": "^7.0.2"
  }
}
